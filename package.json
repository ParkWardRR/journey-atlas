  "version": "1.0.0",
  "type": "module",
  "license": "BlueOak-1.0.0",
  "keywords": [
    "map",
    "leaflet",
    "svelte",
    "road-trip",
    "cartography",
    "gpx",
    "travel",
    "poster"
  ],
  "scripts": {
