    "build": "vite build",
    "preview": "vite preview",
    "build:trip": "node scripts/build-trip.mjs",
    "render": "node scripts/render.mjs",
    "weather": "node scripts/fetch-weather.mjs",
    "verify-gps": "node scripts/verify-gps.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "ajv": "^8.20.0",
    "playwright": "^1.63.0",
    "svelte": "^5.1.0",
    "vite": "^5.4.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
